# Only runtime reads .env. Do not commit real secrets.
TELEGRAM_BOT_TOKEN=
# Private chat only; usually the same positive numeric ID as USER_ID.
TELEGRAM_CHAT_ID=0
TELEGRAM_USER_ID=0
MOODLE_URL=https://mentor.khai.edu
POLL_SECONDS=300
# Optional known course IDs, comma separated, useful for custom dashboards.
COURSE_IDS=
SELECTORS_FILE=config/selectors.json
DATA_DIR=data
# Installed Google Chrome. Use chromium for the bundled Playwright test browser.
BROWSER_CHANNEL=chrome
# Optional extra status tab; browser and Telegram work without it.
SHOW_PANEL=false
ACTION_DELAY_MIN=0.25
ACTION_DELAY_MAX=0.65
MIN_CONFIDENCE=0.55
# Pause for manual input on unknown widgets, unreadable images or uncertain answers.
# Explicit alternative: skip (count the question as skipped by the agent).
UNCERTAIN_ANSWER_POLICY=pause
CONFIRMATION_TTL=900

# Default: uses your own Codex CLI ChatGPT login; no API key.
LLM_BACKEND=codex
CODEX_COMMAND=codex
# Empty = CLI default model. Must support image attachments for visual questions.
CODEX_MODEL=
# Default: high. Available levels depend on the selected model and Codex CLI.
CODEX_REASONING_EFFORT=high
LLM_TIMEOUT=180
LLM_RETRIES=2

# Optional alternative: LLM_BACKEND=openai for local/cloud compatible server.
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_API_KEY=
LLM_MODEL=your-local-vision-model
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200
LLM_JSON_MODE=true
LLM_SEND_TEMPERATURE=true
LLM_VISION=true
